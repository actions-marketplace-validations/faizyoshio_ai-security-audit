{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AISecurityAuditFindingsLedger",
  "type": "object",
  "properties": {
    "audit_id": { "type": "string" },
    "target": { "type": "string" },
    "auditor": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"] },
          "owasp_code": { "type": "string" },
          "affected_component": { "type": "string" },
          "reproduction": { "type": "string" },
          "proof_of_impact": { "type": "string" },
          "verified": { "type": "boolean" },
          "remediation": { "type": "string" }
        },
        "required": ["id", "title", "severity", "owasp_code", "affected_component", "verified"]
      }
    }
  },
  "required": ["audit_id", "target", "timestamp", "findings"]
}
